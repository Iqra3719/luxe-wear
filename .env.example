# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings → API). See README.md for the full 10-minute
# setup walkthrough, including the SQL to create the products table.
#
# Until these are set, the site automatically shows demo products instead
# of looking broken or blank — see lib/getProducts.ts.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
